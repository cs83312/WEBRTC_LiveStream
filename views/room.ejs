<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

   <script>
       const RoomID="<%=  roomId %>"
   </script>
   <script src="/socket.io/socket.io.js" defer></script>
   <script src="script.js" defer></script>
   <script src="KeyBoardHandler.js" defer></script>
   <script src="rtcStream.js" defer></script>
   <script src="httpRequest.js" defer></script>
   <script src="Device.js"></script>

    <title>Document</title>

    <style>
        #video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,300px);
            grid-template-rows: 300px;
        }
        video {
            width:100%;
        }
            </style>
    <script>
        const room_Id = "<%= roomId %>"
    </script>
    <script src="/socket.io/socket.io.js" defer></script>
    <script src="script.js" defer></script>
    <title>Document</title>
    <style>
        #video-grid {
            display: grid;
            grid-template-columns: repeat(aut-fill,300px);
            grid-auto-rows: 300px;
        }
        #myVideo {
  transform: scaleX(-1);
}
        video {
            width: 100%;

            height: 100%;
            object-fit: cover;
        }
    </style>

    
</head>
<body onload="startup()">
    <div>

 <button class="initialBtn" onclick="createMedia()">初始化</button>
      
  <button class="joinBtn">join room</button>
  
  <button class="btnCall">send offer</button>
                           
  <video width="200" height="200" autoplay
    id="myVideo" muted playsinline></video>
                              
  <video width="500" height="500" autoplay
    id="remoteVideo" playsinline></video>
    </div>
     <div id="mjs" class="tip">獲取滑鼠點選位置座標</div> 
     <div id="test" style="width:500px;height:500px;background:#ccc;" onmousemove="test(event)"></div> 



     <div class="messagebox">
        <label for="message">Enter a message:
            <input type="text" name="message" id="message" placeholder="Message text"
                    inputmode="latin" size=60 maxlength=120 disabled>
          </label>
          <button id="sendButton" name="sendButton" class="buttonright" disabled>
            Send
          </button>
    </div>

     <button id='connectBtn' name='connectBtn' class="buttonleft">connect</button>
     <button id="disconnectBtn" name='disconnectBtn' class='buttonright'>disconnect</button>

     <div class="messagebox" id="receivebox">
        <p>Messages received:</p>
      </div>

     
      <button  onclick="sendStreamRequest()">make call</button>
      <div id="callresult" class="callresult" style="width:200px;height:200px;background:#ccc;"></div>

</head>
<body>
    <div id="video-grid"></div>
</body>
</html>