# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=8009
# Public base URL used in invitation links, e.g. https://consult.example.com
PUBLIC_URL=

# TLS: either point to cert/key (dev: generate with `mkcert localhost 192.168.x.x`)
# or set TRUST_PROXY=true when running behind a TLS-terminating reverse proxy.
TLS_CERT=
TLS_KEY=
TRUST_PROXY=false

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_API_KEY=
TURN_SECRET=

# Comma-separated. Example:
# STUN_URLS=stun:turn.example.com:3478
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
STUN_URLS=
TURN_URLS=
TURN_TTL_SECONDS=600
# all = direct P2P when possible; relay = always via TURN (hides peer IPs, more server bandwidth)
ICE_TRANSPORT_POLICY=all

RECONNECT_GRACE_MS=30000
CONNECTIONS_PER_IP_PER_MINUTE=30
EARLY_JOIN_MINUTES=30
LATE_LEAVE_MINUTES=30

AUDIT_DIR=logs
AUDIT_RETENTION_DAYS=180
